# AIMOC Backend Environment
APP_NAME=AIMOC Backend
APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aimoc
DB_SSLMODE=disable
DB_MAX_OPEN=50
DB_MAX_IDLE=10

# JWT
JWT_ACCESS_SECRET=ubah-saya-ke-secret-acak-panjang-untuk-access
JWT_REFRESH_SECRET=ubah-saya-ke-secret-acak-panjang-untuk-refresh
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006

# Upload
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8080/uploads

# Webhook secret untuk CCTV AI
CCTV_WEBHOOK_SECRET=ubah-saya-untuk-webhook-cctv-ai
